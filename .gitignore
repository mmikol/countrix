# Python
__pycache__/
*.py[cod]
.venv/

# lint, types, tests, coverage
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
.coverage.*

# the page caches and the embedded cluster: built, never committed
.cache-blizzard/
.cache-wiki/
/db/psql/cluster/

# any table copied out as CSV: it holds the rates
*.csv

# the backup service's nightly dumps: the whole database, the rates included
/backups/

# scratch: a throwaway script at the root is never part of the project, and
# `git add -A` has committed two of them
/_*.py
/_*.json

# the bearer token, the uid/gid override
.env

# editors and the OS
.idea/
.vscode/
.DS_Store
._*

# Claude Code's worktrees for parallel agents: never part of the tree
/.claude/worktrees/

# desloppify: local scan state, never committed
.desloppify/

# desloppify writes a scorecard image on every scan
scorecard.png

# the user guide's built site; its venv, user-guide/.venv, is .venv/ above
/user-guide/site/

